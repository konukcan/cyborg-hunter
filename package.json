{
  "name": "cyborg-hunter",
  "version": "0.7.5",
  "description": "Detect LLM-assisted 'cyborg' behavior in online behavioral experiments",
  "main": "dist/cyborg-hunter.min.js",
  "module": "dist/cyborg-hunter.esm.js",
  "bin": {
    "cyborg-hunter": "bin/cyborg-hunter.js"
  },
  "scripts": {
    "build": "node build.js",
    "demo:preview": "node tools/build-preview-core.mjs",
    "test:browser": "echo 'Open tests/browser/integrity-monitor.test.html in a browser'",
    "test:cli": "node --test tests/cli/*.test.js",
    "test:core": "node --test tests/core/*.test.js",
    "test:jspsych": "node --test tests/jspsych/*.test.js",
    "test:tools": "node --test tests/tools/*.test.js",
    "test:demo": "node --test tests/demo/*.test.js",
    "test": "npm run test:core && npm run test:replay && npm run test:cli && npm run test:jspsych && npm run test:tools && npm run test:demo && npm run test:schema",
    "test:replay": "node --test tests/replay/*.test.js",
    "test:schema": "node --test tests/replay/schema-v2/*.test.js",
    "test:browser:replay": "node tests/browser/replay/run-replay-tests.mjs",
    "test:browser:alignment": "node tests/browser/replay/cursor-alignment.battery.mjs",
    "test:browser:boot": "node tests/browser/replay/viewer-boot.battery.mjs",
    "test:browser:capture": "node tests/browser/replay/capture-chromium.battery.mjs",
    "test:browser:fork": "node tests/browser/replay/capture-fork-smoke.mjs",
    "test:e2e": "playwright test"
  },
  "files": [
    "dist/",
    "bin/",
    "src/",
    "README.md",
    "CHANGELOG.md",
    "CITATION.cff"
  ],
  "keywords": [
    "integrity",
    "cheating-detection",
    "online-experiments",
    "jspsych",
    "prolific",
    "mturk",
    "behavioral-research"
  ],
  "type": "module",
  "license": "MIT",
  "author": "Can Konuk",
  "homepage": "https://github.com/cyborg-hunter/cyborg-hunter#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cyborg-hunter/cyborg-hunter.git"
  },
  "bugs": {
    "url": "https://github.com/cyborg-hunter/cyborg-hunter/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "optionalDependencies": {
    "canvas": "^3.2.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "ajv": "^8.20.0",
    "esbuild": "^0.21.0",
    "happy-dom": "^20.9.0"
  },
  "dependencies": {
    "papaparse": "^5.5.3"
  }
}
